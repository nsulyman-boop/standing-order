# Copy to .env (gitignored) or export in your shell. Every knob the scripts read is listed here.

# ---- Network -------------------------------------------------------------------------------
# testnet (default) or mainnet
NEAR_NETWORK=testnet
# RPC endpoint; defaults to FastNEAR for the chosen network
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# Node 22's fetch ignores HTTPS_PROXY unless this is set (needed behind a corporate/CI proxy)
# NODE_USE_ENV_PROXY=1

# ---- Accounts (scripts/lib/near.ts) ----------------------------------------------------------
# Keys are read from ~/.near-credentials/<network>/<account>.json, or from
# KEY_<ACCOUNT_WITH_DOTS_AND_DASHES_AS_UNDERSCORES>=ed25519:... (e.g. KEY_COUNCIL1_STANDING_ORDER_TESTNET=ed25519:...)
# Funded top-level account that creates sub-accounts and owns the contract
SO_MASTER=standing-order.testnet
# Account the contract is deployed to (usually = SO_MASTER)
SO_CONTRACT=standing-order.testnet
# Sputnik DAO factory
SO_FACTORY=sputnik-v2.testnet
# DAO name; the DAO account becomes <SO_DAO_NAME>.<SO_FACTORY>
SO_DAO_NAME=payroll-demo
# Full DAO account id, overrides SO_DAO_NAME.SO_FACTORY (use for an existing DAO, e.g. on mainnet)
# SO_DAO=payroll-demo.sputnik-v2.testnet
# NEP-141 token the plans pay in (public-mint USDC.e on testnet; mainnet USDC in docs/MAINNET.md)
SO_TOKEN=usdc.fakes.testnet
# Council members (comma-separated); the first one files proposals, all of them vote
SO_COUNCIL=council1.standing-order.testnet,council2.standing-order.testnet
# Payroll recipients (comma-separated), paid in the order given
SO_RECIPIENTS=dev1.standing-order.testnet,dev2.standing-order.testnet,design.standing-order.testnet
# Keeper account that calls run_due; defaults to keeper.<SO_MASTER>
SO_KEEPER=keeper.standing-order.testnet

# ---- Deploy / DAO / token setup --------------------------------------------------------------
# scripts/deploy.ts: contract config min_interval_seconds (shortest plan cadence accepted)
# SO_MIN_INTERVAL=60
# scripts/create-dao.ts: NEAR deposited into the new DAO through the factory
# SO_DAO_DEPOSIT=6
# scripts/token.ts: target token balance minted to the DAO (whole tokens)
# SO_DAO_TOKENS=5000
# scripts/keeper-key.ts: gas allowance (NEAR) of the keeper's run_due-only function-call key
# SO_KEEPER_ALLOWANCE=2

# ---- Plan proposal (scripts/propose-plan.ts) --------------------------------------------------
# Seconds between runs
# SO_INTERVAL=120
# Per-recipient amounts in whole tokens, one per SO_RECIPIENTS entry
# SO_AMOUNTS=100,80,60
# Number of runs funded up front (fund = runs x per-run total)
# SO_RUNS=5
# Plan title shown on the dashboard
# SO_TITLE="Core contributors, every 2 minutes (demo)"

# ---- Demo script (scripts/demo-full-loop.sh) --------------------------------------------------
# Where the demo writes propose-* logs
# SO_DEMO_LOG_DIR=/tmp/standing-order-demo

# ---- Trezu templates (trezu-templates/generate.ts) --------------------------------------------
# Token symbol and decimals baked into the generated templates (default from the network)
# SO_TOKEN_SYMBOL=USDC
# SO_TOKEN_DECIMALS=6

# ---- Keeper (keeper/src; see keeper/.env.example, written by scripts/keeper-key.ts) ------------
# Account that holds the run_due-only function-call key
# KEEPER_ACCOUNT=keeper.standing-order.testnet
# The function-call key itself (ed25519:...). Never a full-access key: the keeper refuses to start with one.
# KEEPER_KEY=ed25519:...
# Seconds between keeper ticks
# POLL_SECONDS=15
# Serve a JSON status endpoint on this port (the dashboard's VITE_KEEPER_URL points at it); unset = no server
# KEEPER_HTTP_PORT=8787
# Where the keeper appends its JSONL run log
# KEEPER_LOG=keeper/data/runs.jsonl
# Cross-chain mode: off (pay on NEAR), dry (quote for logging, pay on NEAR; testnet default), live (route payouts; mainnet default)
# CROSSCHAIN=dry
# 1Click base URL
# ONE_CLICK_URL=https://1click.chaindefuser.com
# Optional 1Click partner JWT: 1 bp fee on stablecoin routes instead of 0.25%
# ONE_CLICK_JWT=
# Slippage tolerance for quotes, in basis points
# ROUTE_SLIPPAGE_BPS=100
