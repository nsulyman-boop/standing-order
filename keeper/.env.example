# Keeper configuration. `npm run keeper:key` (scripts/keeper-key.ts) writes keeper/.env with a fresh
# function-call key; this file documents the knobs. Never put a full-access key here: the keeper
# checks the key on start and refuses anything broader than <SO_CONTRACT>:run_due.

# testnet or mainnet
NEAR_NETWORK=testnet
# RPC endpoint; defaults to FastNEAR for the network
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# Standing Order contract the keeper triggers
SO_CONTRACT=standing-order.testnet
# Account that holds the restricted key
KEEPER_ACCOUNT=keeper.standing-order.testnet
# Function-call key limited to run_due on SO_CONTRACT (ed25519:...)
KEEPER_KEY=ed25519:REPLACE_WITH_THE_KEY_WRITTEN_BY_npm_run_keeper_key
# Seconds between ticks (each tick asks get_due_plans and calls run_due per due plan)
POLL_SECONDS=15
# Serve GET / as JSON status on this port for the dashboard (VITE_KEEPER_URL=http://localhost:8787/); unset = off
# KEEPER_HTTP_PORT=8787
# JSONL run log location
# KEEPER_LOG=keeper/data/runs.jsonl
# off | dry | live. dry (testnet default) fetches 1Click quotes for logging but pays on NEAR; live (mainnet default) routes payouts.
# CROSSCHAIN=dry
# 1Click base URL
# ONE_CLICK_URL=https://1click.chaindefuser.com
# Optional 1Click partner JWT (1 bp fee on stablecoin routes instead of 0.25%)
# ONE_CLICK_JWT=
# Slippage tolerance for 1Click quotes, in basis points
# ROUTE_SLIPPAGE_BPS=100
